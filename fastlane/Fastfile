require 'xcodeproj'

default_platform(:ios)

# bundle id 单一数据源 = ios/Runner.xcodeproj。Xcode 里改完，Fastfile 自动跟随，
# 不再硬编码 bundle id。用 xcodeproj 直接读 pbxproj，不依赖 Xcode/SDK
# （regen-ios-profiles.yaml 没有 Xcode/flutter 步骤，不能依赖 xcodebuild）。
# 注意：路径必须用绝对路径。fastlane 会切到 fastlane/ 目录执行，相对路径会被解析到
# fastlane/ 下。__dir__ = Fastfile 所在目录（fastlane/），上跳一级（../ios）才是仓库根。
def resolve_bundle_id(target_name)
  project = Xcodeproj::Project.open(File.expand_path('../ios/Runner.xcodeproj', __dir__))
  target = project.targets.find { |t| t.name == target_name }
  raise "target #{target_name} not found" unless target
  config = target.build_configurations.find { |c| c.name == 'Release' }
  value = config&.build_settings&.dig('PRODUCT_BUNDLE_IDENTIFIER')
  raise "#{target_name} 的 Release PRODUCT_BUNDLE_IDENTIFIER 未设置" if value.nil? || value.empty?
  value
end

def app_bundle_id
  @app_bundle_id ||= resolve_bundle_id('Runner')
end

def packet_tunnel_bundle_id
  @packet_tunnel_bundle_id ||= resolve_bundle_id('PacketTunnel')
end

platform :ios do
  desc "Download provisioning profiles from Apple"
  lane :download_profiles do
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )
    sigh(
      app_identifier: app_bundle_id,
      force: false,
      readonly: true,
      development: false
    )
    sigh(
      app_identifier: packet_tunnel_bundle_id,
      force: false,
      readonly: true,
      development: false
    )
  end

  desc "Regenerate App Store distribution profiles with the current certificate (saved to ios/)"
  lane :regenerate_profiles do
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )
    # force: true -> 用账号里最新的 Distribution 证书重建 profile，
    # 以匹配 IOS_CERTIFICATE secret（Apple Distribution 证书）。
    # 不设 filename：sigh 按 portal 里的 Name 输出，由 regen-ios-profiles.yaml 的
    # "Verify and stage" 步骤校验后重命名为 ToWorld.mobileprovision / ToWorldPacketTunnel.mobileprovision。
    sigh(
      app_identifier: app_bundle_id,
      force: true,
      development: false,
      output_path: File.expand_path('../ios', __dir__)
    )
    sigh(
      app_identifier: packet_tunnel_bundle_id,
      force: true,
      development: false,
      output_path: File.expand_path('../ios', __dir__)
    )
  end

  desc "Upload built IPA to TestFlight"
  lane :deploy_testflight do |options|
    # ipa 由 workflow 的 Build & Export IPA 步骤（原生 xcodebuild archive+export）产出。
    # 不要用 gym build_app：它会同时把 CODE_SIGNING_ALLOWED=NO 传给 export，导致 export 卡死。
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )

    upload_to_testflight(
      ipa: "dist/ToWorld-ios-arm64.ipa",
      app_identifier: app_bundle_id,
      skip_waiting_for_build_processing: true
    )
  end
end
