default_platform(:ios)

platform :ios do
  desc "Download provisioning profiles from Apple"
  lane :download_profiles do
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )
    sigh(
      app_identifier: "uk.toworld.flclash",
      force: false,
      readonly: true,
      development: false
    )
    sigh(
      app_identifier: "uk.toworld.flclash.PacketTunnel",
      force: false,
      readonly: true,
      development: false
    )
  end

  desc "Regenerate App Store distribution profiles with the current certificate (saved to ios/)"
  lane :regenerate_profiles do
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )
    # force: true -> 用账号里最新的 Distribution 证书重建 profile，
    # 以匹配 IOS_CERTIFICATE secret（Apple Distribution 证书）。
    sigh(
      app_identifier: "uk.toworld.flclash",
      force: true,
      development: false,
      output_path: "ios/"
    )
    sigh(
      app_identifier: "uk.toworld.flclash.PacketTunnel",
      force: true,
      development: false,
      output_path: "ios/"
    )
  end

  desc "Upload built IPA to TestFlight"
  lane :deploy_testflight do |options|
    # ipa 由 workflow 的 Build & Export IPA 步骤（原生 xcodebuild archive+export）产出。
    # 不要用 gym build_app：它会同时把 CODE_SIGNING_ALLOWED=NO 传给 export，导致 export 卡死。
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )

    upload_to_testflight(
      ipa: "dist/ToWorld-ios-arm64.ipa",
      app_identifier: "uk.toworld.flclash",
      skip_waiting_for_build_processing: true
    )
  end
end
