default_platform(:ios)

platform :ios do
  desc "Download provisioning profiles from Apple"
  lane :download_profiles do
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )
    sigh(
      app_identifier: "uk.toworld.flclash",
      force: false,
      readonly: true,
      development: false
    )
    sigh(
      app_identifier: "uk.toworld.flclash.PacketTunnel",
      force: false,
      readonly: true,
      development: false
    )
  end

  desc "Regenerate App Store distribution profiles with the current certificate (saved to ios/)"
  lane :regenerate_profiles do
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )
    # force: true -> 用账号里最新的 Distribution 证书重建 profile，
    # 以匹配 IOS_CERTIFICATE secret（Apple Distribution 证书）。
    sigh(
      app_identifier: "uk.toworld.flclash",
      force: true,
      development: false,
      output_path: "ios/"
    )
    sigh(
      app_identifier: "uk.toworld.flclash.PacketTunnel",
      force: true,
      development: false,
      output_path: "ios/"
    )
  end

  desc "Build signed IPA and upload to TestFlight"
  lane :deploy_testflight do |options|
    # 注意：不要调用 setup_ci——它会在 CI 里新建 fastlane_tmp_keychain 并把默认
    # keychain 切走，而我们已在 workflow 中把自己的 build.keychain 设为默认并导入证书。
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )

    # 证书 + Provisioning Profile 已由 GitHub Actions 安装到
    # ~/Library/MobileDevice/Provisioning Profiles 与默认 keychain，
    # 这里沿用旧的 xcodebuild 方案：先无签名 archive，再在 export 阶段手动签名。
    build_number = options[:build_number]
    xcargs = "IPHONEOS_DEPLOYMENT_TARGET=15.0 CODE_SIGNING_ALLOWED=NO"
    xcargs += " CURRENT_PROJECT_VERSION=#{build_number}" if build_number && !build_number.to_s.empty?

    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      xcargs: xcargs,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        teamID: "9ZKNBU3VL4",
        signingStyle: "manual",
        provisioningProfiles: {
          "uk.toworld.flclash" => "ToWorld",
          "uk.toworld.flclash.PacketTunnel" => "ToWorldPacketTunnel"
        }
      },
      output_directory: "dist",
      output_name: "ToWorld-ios-arm64"
    )

    upload_to_testflight(
      app_identifier: "uk.toworld.flclash",
      skip_waiting_for_build_processing: true
    )
  end
end
