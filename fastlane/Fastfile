default_platform(:ios)

platform :ios do
  desc "Download provisioning profiles from Apple"
  lane :download_profiles do
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_API_KEY']
    )
    sigh(
      app_identifier: "uk.toworld.flclash",
      force: false,
      readonly: true,
      development: false
    )
    sigh(
      app_identifier: "uk.toworld.flclash.PacketTunnel",
      force: false,
      readonly: true,
      development: false
    )
  end
end
